<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aucune permission INTERNET : l'application ne peut faire aucun appel réseau. -->

    <!-- Notification du chrono (Android 13+), demandée après l'écran 9. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Sauvegarde : allowBackup="false" coupe tout jusqu'à Android 11 (fullBackupContent est donc inutile) ;
        à partir d'Android 12, les règles d'extraction excluent le cloud et permettent le transfert direct.
    -->
    <application
        android:name=".IronTapApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regles_extraction_donnees"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IronTap"
        tools:ignore="DataExtractionRules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boutons de la notification du chrono : non exporté, seules les intentions explicites de l'appli l'atteignent. -->
        <receiver
            android:name=".notification.RecepteurChrono"
            android:exported="false" />
    </application>

</manifest>
