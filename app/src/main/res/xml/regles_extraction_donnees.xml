<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ : aucune sauvegarde dans le cloud ; le transfert direct vers un nouveau téléphone
    (assistant de transfert, câble) reste permis pour ne pas perdre l'historique. Cf. DECISIONS.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
